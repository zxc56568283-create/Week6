import requests
from bs4 import BeautifulSoup
import pandas as pd

# 1. 建立 Session 物件以維持登入狀態
session = requests.Session()

login_url = "http://quotes.toscrape.com/login"

# 2. 發送 GET 請求取得登入頁面與 csrf_token
response = session.get(login_url)
soup = BeautifulSoup(response.text, "html.parser")

# 取得隱藏的 csrf_token
csrf_token = soup.find("input", {"name": "csrf_token"})["value"]

# 3. 準備登入資料（Quotes to Scrape 支援任意帳號密碼登入）
payload = {
    "csrf_token": csrf_token,
    "username": "student",
    "password": "password"
}

# 4. 發送 POST 請求完成登入
login_response = session.post(login_url, data=payload)

# 5. 爬取第一頁的所有名言資料
# 登入成功後通常會自動重定向至首頁，此處亦可直接請求首頁
quotes_data = []
page_soup = BeautifulSoup(login_response.text, "html.parser")
quote_elements = page_soup.find_all("div", class_="quote")

for item in quote_elements:
    # 擷取名言文字（去除前後空白或多餘引號）
    quote_text = item.find("span", class_="text").get_text(strip=True)
    
    # 擷取作者
    author = item.find("small", class_="author").get_text(strip=True)
    
    # 擷取所有 tags 並以「;」串接
    tag_elements = item.find_all("a", class_="tag")
    tags = ";".join([tag.get_text(strip=True) for tag in tag_elements])
    
    quotes_data.append({
        "page": 1,
        "quote": quote_text,
        "author": author,
        "tags": tags
    })

# 6. 轉為 DataFrame 並儲存為 CSV 檔案
df = pd.DataFrame(quotes_data)

# 指定欄位順序：page、quote、author、tags
df = df[["page", "quote", "author", "tags"]]

# 輸出 CSV 檔案（使用 utf-8-sig 避免 Excel 開啟時出現中文或特殊字元亂碼）
df.to_csv("quotes_first_page.csv", index=False, encoding="utf-8-sig")

print(f"爬取完成！已成功抓取 {len(df)} 筆名言並存成 quotes_first_page.csv。")
